{
  "name": "pdfcatalogo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de pdfcatalogo: autenticación, catálogos, imágenes (Cloudinary) y generación de PDF",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node --env-file-if-exists=.env prisma/seed.js",
    "verify": "node --env-file-if-exists=.env scripts/verify.js",
    "sync:shared": "node -e \"require('fs').copyFileSync('src/shared/renderModel.js','../frontend/src/shared/renderModel.js');console.log('renderModel.js copiado al frontend')\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "puppeteer": "^25.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  }
}
