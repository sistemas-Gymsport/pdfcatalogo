# ============================================================
#  pdfcatalogo · Backend · Variables de entorno
#  Copia este archivo como .env y completa los valores.
#  NUNCA subas el archivo .env al repositorio (está en .gitignore).
# ============================================================

# ------------------------------------------------------------
# OBLIGATORIAS
# ------------------------------------------------------------

# --- Base de datos (Neon PostgreSQL) ---
# Neon → Dashboard → Connect. Usa dos cadenas:
# DATABASE_URL: conexión "Pooled" (el host contiene "-pooler"). La usa la API.
# DIRECT_URL:   conexión directa (sin "-pooler"). La usa Prisma para migraciones.
# connect_timeout=15 da tiempo a que Neon despierte si estaba suspendido (plan gratuito).
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Sesiones (JWT) ---
# Cadena aleatoria de 32+ caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- CORS ---
# Orígenes que pueden usar la API, separados por coma y SIN "/" final.
# Local: http://localhost:5173   ·   Producción: https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Cloudinary (Dashboard → API Keys) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Primer administrador ---
# Solo los usan "npm run seed" (crear admin) y "npm run verify" (prueba de extremo a extremo).
# No son necesarias para que la API funcione: bórralas del entorno después de usarlas.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------
# OPCIONALES (tienen valores por defecto razonables)
# ------------------------------------------------------------
# NODE_ENV=development          # En Render: production
# PORT=3000                     # Render lo asigna automáticamente
# JWT_EXPIRES_IN=8h             # Duración de la sesión
# CLOUDINARY_FOLDER=pdfcatalogo # Carpeta dentro de Cloudinary
# MAX_UPLOAD_MB=15              # Tamaño máximo por imagen
# ADMIN_RESET_PASSWORD=true     # Con "npm run seed": cambia la contraseña de un admin existente
#
# Generación de PDF (ajustes para servidores con poca memoria):
# PDF_TIMEOUT_MS=120000         # Tiempo máximo por lote de páginas
# PDF_MAX_CONCURRENT=1          # PDFs generados a la vez (los demás esperan)
# PDF_PAGES_PER_BATCH=4         # Páginas por lote: menos = menos memoria
# PUPPETEER_EXECUTABLE_PATH=    # Chrome/Chromium propio (vacío = el que descarga Puppeteer)
