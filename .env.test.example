# Base de datos EXCLUSIVA para tests: se VACÍA en cada ejecución de npm test.
# El nombre de la base debe contener "test" (protección contra borrar producción).
# Copia este archivo como .env.test. Sin él, npm test omite las pruebas que usan base de datos.
TEST_DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/pdfcatalogo_test
